# ==============================================================================
# INSTAVALIABLE — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copy this file to .env and configure real credentials for your environment.
# Never commit your actual .env file with secrets to Git.
# ==============================================================================

# Server Port & Mode
PORT=5000
NODE_ENV=production

# MongoDB Database Connection URL
MONGO_URI=mongodb://localhost:27017/instavaliable

# JSON Web Token (JWT) Security Secrets
# Generate a cryptographically secure 64-character secret in production
JWT_SECRET=your_production_secure_jwt_secret_key_minimum_32_characters
JWT_EXPIRES_IN=7d

# Official Support WhatsApp Contact Number (International E.164 format, digits only or with +)
WHATSAPP_BUSINESS_NUMBER=+919876543210

# Super Admin Initial Bootstrap Setup Secret
# Used once by authorized devops/admin to initialize the first Super Admin
ADMIN_SETUP_SECRET=your_custom_super_admin_setup_secret_key_2026

# ==============================================================================
# SMTP Email Configuration (Required for Live Email OTP Delivery)
# ==============================================================================
# FOR HOSTINGER BUSINESS EMAIL (Recommended):
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=your_business_email@yourdomain.com
# SMTP_PASS=your_email_password
# EMAIL_FROM="Instavaliable" <your_business_email@yourdomain.com>
#
# FOR GMAIL / GOOGLE WORKSPACE:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_16_digit_google_app_password
# EMAIL_FROM="Instavaliable" <your_email@gmail.com>

SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Instavaliable" <no-reply@instavaliable.com>

